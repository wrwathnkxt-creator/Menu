# ============================================================
# .gitignore — SmartKitchen GitHub Pages Project
# ป้องกันไฟล์ที่มีข้อมูลสำคัญและไม่ควร commit ขึ้น GitHub
# ============================================================

# ──────────────────────────────────────────────────────────
# 🔐 SECRET & CONFIG FILES — ไฟล์ข้อมูลสำคัญ / credentials
# ──────────────────────────────────────────────────────────
docs/js/config.js
*.env
.env.*
*.secret
*.secrets
secrets/
credentials/
*credentials*
*token*
*apikey*
*api_key*
*.key
*.pem
*.p12
*.pfx

# ──────────────────────────────────────────────────────────
# 📄 GOOGLE APPS SCRIPT — ไฟล์ GAS ไม่ push ผ่าน GitHub
# (ใช้ clasp หรือ copy/paste ใน script.google.com โดยตรง)
# ──────────────────────────────────────────────────────────
gas/
*.gs
*.gs.bak
appsscript.json
.clasp.json

# ──────────────────────────────────────────────────────────
# 📝 DOCUMENT FILES — ไฟล์เอกสารที่ไม่เกี่ยวกับ web
# ──────────────────────────────────────────────────────────
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.pdf
*.txt
*.csv
*.tsv
*.odt
*.ods

# ──────────────────────────────────────────────────────────
# 🖼️ MEDIA — ไฟล์ขนาดใหญ่ (ใช้ Google Drive แทน)
# ──────────────────────────────────────────────────────────
*.psd
*.ai
*.sketch
*.fig
*.xd
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ──────────────────────────────────────────────────────────
# 🛠️ OS & EDITOR — ไฟล์ระบบ/โปรแกรมแก้ไข
# ──────────────────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/*.log

# JetBrains IDEs
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ──────────────────────────────────────────────────────────
# 📦 NODE / PACKAGE MANAGERS (ถ้าใช้ในอนาคต)
# ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*

# ──────────────────────────────────────────────────────────
# 📋 LOG & TEMP FILES — ไฟล์ log และชั่วคราว
# ──────────────────────────────────────────────────────────
*.log
*.log.*
logs/
tmp/
temp/
.tmp/
.cache/
*.bak
*.backup
*.orig
*.old

# ──────────────────────────────────────────────────────────
# 🧪 TEST & BUILD (ถ้าใช้ในอนาคต)
# ──────────────────────────────────────────────────────────
dist/
build/
out/
coverage/
.nyc_output/
*.test.js.snap

# ──────────────────────────────────────────────────────────
# 🗃️ DATABASE & DATA DUMPS
# ──────────────────────────────────────────────────────────
*.sql
*.db
*.sqlite
*.sqlite3
*.dump
data/
database/

# ──────────────────────────────────────────────────────────
# 📁 PLANNING & INTERNAL DOCS (ไม่ต้องการใน repo สาธารณะ)
# ──────────────────────────────────────────────────────────
planning/
*.md.bak

# ──────────────────────────────────────────────────────────
# ✅ EXCEPTIONS — ไฟล์ที่ยกเว้น (อนุญาตให้ push)
# ──────────────────────────────────────────────────────────
# README.md ของโปรเจกต์อนุญาต
!README.md
# ไฟล์ config ตัวอย่าง (ไม่มีข้อมูลจริง) อนุญาต
!docs/js/config.example.js
